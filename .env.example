# Copier vers .env.local (jamais commité). Aucun secret dans le dépôt.
DATABASE_URL=postgres://mazet:mazet_dev@localhost:5432/mazet_dev
TEST_DATABASE_URL=postgres://mazet:mazet_dev@localhost:5432/mazet_test

# Auth.js : `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth (console Google Cloud, URI de redirection :
# http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Hors Vercel, Auth.js exige cette variable pour faire confiance à l'hôte (local uniquement).
AUTH_TRUST_HOST=true
